meta {
  name: Transfer - invalid fields (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/transactions/transfer
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{invalidKey}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "beneficiaryName": "",
    "mobileNumber": "98765",
    "amount": 10.123
  }
}

script:pre-request {
  const { v4: uuid } = require("uuid");
  bru.setVar("invalidKey", uuid());
}

tests {
  test("400 VALIDATION_ERROR in the common error shape", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().success).to.equal(false);
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().error.message).to.be.a("string");
  });

  test("each bad field is named", function () {
    expect(res.getBody().error.fields).to.have.all.keys("beneficiaryName", "mobileNumber", "amount");
  });
}
