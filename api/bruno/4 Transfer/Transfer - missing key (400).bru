meta {
  name: Transfer - missing key (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/transactions/transfer
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "beneficiaryName": "Rahul Sharma",
    "mobileNumber": "9876543210",
    "amount": 1500,
    "remarks": "Dinner split"
  }
}

tests {
  test("400 IDEMPOTENCY_KEY_REQUIRED in the common error shape", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().success).to.equal(false);
    expect(res.getBody().error.code).to.equal("IDEMPOTENCY_KEY_REQUIRED");
    expect(res.getBody().error.message).to.be.a("string");
  });
}
